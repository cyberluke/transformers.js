OPENAI_API_KEY=REDACTED-OPENAI-KEY


# S3 related environment variables (example using MinIO)
# Required: S3 Access Key ID (for MinIO, invalid until manually created in MinIO UI)
S3_ACCESS_KEY_ID=REDACTED-S3-ACCESS-KEY
# Required: S3 Secret Access Key (for MinIO, invalid until manually created in MinIO UI)
S3_SECRET_ACCESS_KEY=REDACTED-S3-SECRET-KEY
# Required: S3 Endpoint for server/client connections to S3 API
S3_ENDPOINT=https://REDACTED-S3-ENDPOINT.example.com
# Required: S3 Bucket (invalid until manually created in MinIO UI)
S3_BUCKET=nanotriko
# Required: S3 Public Domain for client access to unstructured data
S3_PUBLIC_DOMAIN=https://s4.nanotrik.ai
S3_ENABLE_PATH_STYLE=0

DATABASE_URL=postgresql://postgres:REDACTED-DB-PASSWORD@localhost:5432/newchat



KEY_VAULTS_SECRET=REDACTED-VAULT-SECRET
#NEXT_AUTH_SECRET=REDACTED-AUTH-SECRET
NEXT_AUTH_SECRET=REDACTED-AUTH-SECRET

AUTH_CASDOOR_ISSUER=https://logindev.nanotrik.ai
# Casdoor secret
AUTH_CASDOOR_ID=REDACTED-CASDOOR-ID
AUTH_CASDOOR_SECRET=REDACTED-CASDOOR-SECRET


NEXT_PUBLIC_FINGERPRINT_API_KEY=REDACTED-FP-PUBLIC-KEY
NEXT_PUBLIC_FINGERPRINT_ENDPOINT=

FINGERPRINT_API_KEY=REDACTED-FP-SERVER-KEY

MEM0_API_URL=https://mem.nanotrik.ai

ANTHROPIC_API_KEY=REDACTED-ANTHROPIC-KEY

SEARXNG_URL=https://ds.nanotrik.ai

