{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.{ts,tsx,js,jsx,json}"],
    "experimentalScannerIgnores": [
      "node_modules/**",
      "dist/**",
      ".next/**",
      "*.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "style": {
        "recommended": false,
        "useImportType": "off",
        "useBlockStatements": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "recommended": false,
        "noExplicitAny": "off",
        "noConsole": "off",
        "noDocumentCookie": "off"
      },
      "correctness": {
        "recommended": true,
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "quoteProperties": "asNeeded"
    }
  },
  "assist": {
    "enabled": false
  }
}
